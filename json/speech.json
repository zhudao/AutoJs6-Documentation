                  "params": []
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[p+] models"
        },
        {
          "textRaw": "SpeechSession",
          "name": "speechsession",
          "desc": "<p>该对象继承 EventEmitter. <code>on</code> / <code>once</code> 注册监听并返回会话本身. 属性包括 <code>id</code>, <code>modelId</code>, <code>startedAt</code>, <code>source</code>, <code>round</code>, <code>state</code>, <code>reason</code>, <code>isEnded</code>. <code>id</code> 和 <code>modelId</code> 在 <code>ready</code> 前为 <code>null</code>; <code>reason</code> 在结束前为 <code>null</code>; <code>state</code> 依次为 <code>&#39;pending&#39;</code>, <code>&#39;active&#39;</code>, <code>&#39;ended&#39;</code>.</p>\n<ul>\n<li><code>isActive()</code>: 尚未结束时返回 <code>true</code>.</li>\n<li><code>result()</code>: 返回目前已确定的文本; 会话结束后返回整段结果.</li>\n<li><code>stop()</code>: 冲刷最终结果并结束, 返回会话, 可重复调用.</li>\n<li><code>cancel()</code>: 不产生最终结果地结束, 返回会话, 可重复调用.</li>\n<li><code>feed(pcm)</code>: 仅适用于 <code>&#39;external&#39;</code> 来源, 输入 16 kHz 单声道 PCM16 LE, 每次最多 1 MiB, 返回会话.</li>\n</ul>\n<p>事件包括 <code>ready({ sessionId, modelId })</code>, <code>partial</code> / <code>final</code> (带 <code>text</code>), <code>endpoint</code> (无参数), <code>vad({ active })</code>, <code>warning({ code, message })</code>, <code>error(SpeechError)</code>, <code>end({ reason, text })</code>. <code>end</code> 的原因包括 <code>&#39;stopped&#39;</code>, <code>&#39;timeout&#39;</code>, <code>&#39;maxDuration&#39;</code>, <code>&#39;cancelled&#39;</code>, <code>&#39;error&#39;</code>.</p>\n",
          "type": "module",
          "displayName": "SpeechSession"
        },
        {
          "textRaw": "SpeechWakeSession",
          "name": "speechwakesession",
          "desc": "<p>该对象继承 EventEmitter, 属性包括 <code>keywords</code>, <code>id</code>, <code>modelId</code>, <code>startedAt</code>, <code>state</code>, <code>reason</code>, <code>isEnded</code>. 提供 <code>stop()</code> 与 <code>isActive()</code>, 不提供听写会话的 <code>feed</code>, <code>cancel</code>, <code>result</code>.</p>\n<p>事件包括 <code>ready</code>, <code>wake({ keyword, score, timestampMillis, listen? })</code>, <code>warning</code>, <code>error</code>, <code>end({ reason })</code>. 引擎未提供命中分数时 <code>score</code> 可以为 <code>null</code>. 设置 <code>thenListen</code> 后, 在 <code>wake</code> 回调中向 <code>event.listen</code> 注册该轮的听写事件.</p>\n",
          "type": "module",
          "displayName": "SpeechWakeSession"
        },
        {
          "textRaw": "[p] SpeechError",
          "name": "[p]_speecherror",
          "methods": [
            {
              "textRaw": "new speech.SpeechError(message?, code?)",
              "type": "method",
              "name": "SpeechError",
              "desc": "<p>构造继承 Error 的脚本错误对象, 也可不使用 <code>new</code>. <code>message</code> 和 <code>code</code> 转换为字符串, 缺省分别为空字符串和 <code>&#39;INTERNAL&#39;</code>. 可通过 <code>error instanceof speech.SpeechError</code> 与 <code>error.code</code> 判断错误.</p>\n<p>常见错误码包括 <code>PLUGIN_UNAVAILABLE</code>, <code>PLUGIN_DISABLED</code>, <code>PLUGIN_INCOMPATIBLE</code>, <code>PERMISSION_DENIED</code>, <code>MODEL_MISSING</code>, <code>MODEL_DOWNLOAD_FAILED</code>, <code>MODEL_CHECKSUM_MISMATCH</code>, <code>MODEL_LICENSE_NOT_ACCEPTED</code>, <code>INVALID_OPTIONS</code>, <code>UNSUPPORTED_FORMAT</code>, <code>LIMIT_EXCEEDED</code>, <code>SESSION_BUSY</code>, <code>SESSION_CLOSED</code>, <code>SESSION_CANCELLED</code>, <code>ENGINE_FAILED</code>, <code>IO_FAILED</code>, <code>TIMEOUT</code>, <code>INTERNAL</code>.</p>\n",
              "signatures": [
                {
                  "params": [
                    {
                      "name": "message?"
                    },
                    {
                      "name": "code?"
                    }
                  ]
                }
              ]
            }
          ],
          "type": "module",
          "displayName": "[p] SpeechError"
        }
      ],
      "type": "module",
      "displayName": "语音 (Speech)"
    }
  ]
}